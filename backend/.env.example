# backend/.env.example

APP_NAME=Hidden Dependency Intelligence
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

HOST=127.0.0.1
PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hidden_dependency_intelligence

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO